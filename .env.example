# Server
PORT=3000

# Session secret - change this in real deployments
SESSION_SECRET=change-this-to-a-random-long-string

# Basic auth credentials (single admin user, per spec: "basic username/password auth is sufficient")
AUTH_USERNAME=
AUTH_PASSWORD=

# Health checking
# How often (ms) the background job re-checks every monitored app. Default: 30s.
HEALTH_CHECK_INTERVAL_MS=30000
# Per-request timeout (ms) before a check is considered a failure/timeout.
HEALTH_CHECK_TIMEOUT_MS=5000
# How many historical check results to retain per app (for the timeline/uptime bonus).
HEALTH_CHECK_HISTORY_LIMIT=100
